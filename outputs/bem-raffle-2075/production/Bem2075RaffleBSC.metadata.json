    "devdoc": {
      "details": "No organizer, container, processor or funding-window deployment override.",
      "kind": "dev",
      "methods": {
        "rawFulfillRandomWords(uint256,uint256[])": {
          "details": "Cheap callback: no transfers, circuit execution or untrusted external calls."
        },
        "requestDraw(uint256)": {
          "details": "VRF subscription costs are paid separately, never taken from the BEM pool."
        },
        "settle(uint256)": {
          "details": "Transfer to dead address FIRST, then organizer, then winner, atomically. This locks tokens at the dead address; it does NOT reduce BEM totalSupply()."
        }
      },
      "version": 1
    },
    "userdoc": {
      "kind": "user",
      "methods": {
        "authorizeSeries()": {
          "notice": "One-time activation via the chosen container's execute method. No NFT transfer/approval, revocation, or post-randomness holder veto exists."
        },
        "buy(uint256,uint32)": {
          "notice": "Assign the lowest remaining unsold ticket numbers in this round. Explicit selection and automatic allocation share the same payment and draw rules."
        },
        "buySelected(uint256,uint16[])": {
          "notice": "Tickets are zero-based, strictly ascending, unique, and all unsold. Any invalid ticket or payment failure reverts the ENTIRE purchase."
        },
        "openRefunds(uint256)": {
          "notice": "Fixed timeout refunds only BEFORE requesting randomness. After request, funds wait for that exact result and live circuit execution, even if an external dependency is unavailable. No selective cancellation."
        },
        "previewAttempt(uint256,uint256,uint32)": {
          "notice": "Public replay of any attempt. Settlement always uses the stored cursor. The first 20 attempts use disjoint VRF bits. Later attempts use a fixed, domain-separated cryptographic expansion of the SAME verified words."
        },
        "refund(uint256,address)": {
          "notice": "Anyone can pay gas to refund a participant; money always goes to that participant."
        },
        "requestDraw(uint256)": {
          "notice": "Anyone may request exactly one draw for a locked round."
        },
        "runCircuit2075(uint16)": {
          "notice": "MUST call the real circuit. Known arithmetic is a validation guard, not a substitute for the call. Inputs and outputs use little-endian bytes."
        },
        "settle(uint256)": {
          "notice": "Anyone may settle; recipients and amounts cannot be chosen by the caller."
        },
        "ticketOwner(uint256,uint32)": {
          "notice": "Exact zero-based ticket ownership. Unsold tickets return zero. Ownership remains a historical record after refund; tickets cannot be resold."
        },
        "ticketWords(uint256,uint16,uint16)": {
          "notice": "Up to 625 words. Each has 16 low-to-high uint16 buyer IDs; zero=unsold."
        }
      },
      "notice": "Production release target selected by the user: BEHEMOTH #2075's own container authorizes the series and receives 1 BEM per settled round.",
      "version": 1
    }
  },
